+/// What crossed the wire, for an observer such as a packet trace. An observer sees borrowed
+/// bytes only, after the fact: it cannot change what is sent (read-only contract).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Wire<'a> {
+    /// A request as written, report id included.
+    Sent(&'a [u8]),
+    /// A stale input report discarded before a request.
+    Drained(&'a [u8]),
+    /// An input report read while waiting for the reply: ours or another client's.
+    Received(&'a [u8]),
+}
+
+/// A packet observer (see [`Wire`]).
